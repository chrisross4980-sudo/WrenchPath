# ============================================================
# WrenchPath ATL — Root Environment Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to the repository.
# ============================================================

# ── Photon Spectrum Cloud ────────────────────────────────────
# Obtain from https://app.photon.codes after creating a project.
PHOTON_PROJECT_ID=your_project_id_here
PHOTON_PROJECT_SECRET=your_project_secret_here

# ── Backend HTTP Server ──────────────────────────────────────
PORT=3000

# ── AI Agent Service ─────────────────────────────────────────
# URL of the AI Agent service (feature/ai-agent).
AI_SERVICE_URL=http://localhost:4000

# ── AI Client Timeout ────────────────────────────────────────
# Milliseconds to wait for a response from the AI service.
AI_TIMEOUT_MS=5000

# ── Logging ──────────────────────────────────────────────────
# One of: debug | info | warn | error
LOG_LEVEL=info

# ── Environment ──────────────────────────────────────────────
NODE_ENV=development
